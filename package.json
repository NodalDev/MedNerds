{
  "name": "mednerds-web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "realtime:dev": "wrangler dev --config workers/medcases-realtime/wrangler.jsonc --var ENVIRONMENT:development",
    "realtime:typecheck": "wrangler types --config workers/medcases-realtime/wrangler.jsonc workers/medcases-realtime/worker-configuration.d.ts && tsc --project workers/medcases-realtime/tsconfig.json --noEmit",
    "realtime:test": "node --experimental-strip-types scripts/test-medcases-realtime.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@astrojs/starlight": "^0.41.10",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "qrcode-generator": "^2.0.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@iconify-json/healthicons": "^1.2.13",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/tabler": "^1.2.38",
    "wrangler": "^4.143.1"
  }
}
