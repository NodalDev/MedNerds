---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RealtimeDisplay from '../../../components/medcases/RealtimeDisplay';
import '../../../styles/medcases.css';
---

<StarlightPage hasSidebar={false} frontmatter={{
  title: 'OSCE Timer-Display',
  description: 'Passives Display für den synchronisierten OSCE-Raumtimer.',
  pageLayout: 'hub',
  tableOfContents: false,
  pagefind: false,
  head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, nofollow' } }],
}}>
  <div class="osce">
    <RealtimeDisplay client:load />
  </div>
</StarlightPage>
