---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { publicCases } from '../../../../data/medcases/cases';
import type { PublicCase } from '../../../../data/medcases/types';
import { validTimerConfig } from '../../../../lib/medcases/timer';
import '../../../../styles/medcases.css';

export function getStaticPaths() {
  return publicCases.map((item) => ({ params: { caseId: item.id }, props: { item } }));
}
interface Props { item: PublicCase }
const { item } = Astro.props;
---

<StarlightPage hasSidebar={false} frontmatter={{
  title: item.title,
  description: item.summary,
  pageLayout: 'hub',
  tableOfContents: false,
}}>
  <div class="osce osce-overview">
    <nav class="osce-breadcrumb" aria-label="Brotkrumennavigation"><a href="/medcases/">MedCases</a><span aria-hidden="true">›</span><a href="/medcases/osce/">OSCE trainieren</a><span aria-hidden="true">›</span><span>{item.title}</span></nav>
    <p class="osce-eyebrow">{item.specialty} · {item.demo ? 'Demo / Testfall' : 'OSCE'}</p>
    <p class="osce-intro">{item.summary}</p>
    <div class="osce-overview__facts">{validTimerConfig(item.timer) && <span>{item.timer.durationSeconds / 60} Minuten</span>}<span>3 Rollen</span><span>Timer beim Prüfer</span></div>
    <section class="osce-panel"><h2>So läuft dieser Fall ab</h2><ol><li>Wähle den Live-Modus oder den lokalen Timer und öffne die Prüferansicht.</li><li>Bei einer Live-Session treten Prüfling und Schauspielpatient über getrennte Einladungen bei.</li><li>Nach dem verbalen Kommando startet der Prüfer den Timer.</li><li>Der Prüfer führt die Checkliste und öffnet gegebenenfalls das Debriefing nach dem Durchlauf.</li></ol></section>
    <div class="osce-start-grid" aria-label="Startoptionen">
      <section class="osce-panel osce-start-card osce-start-card--live"><span class="osce-eyebrow">Empfohlen</span><h2>Live-OSCE</h2><p>Synchronisiert Timer, Schauspielpatient, Materialfreigaben und Displays.</p><a class="osce-button" href={`/medcases/osce/${item.id}/examiner/?mode=live`}>Live-OSCE starten</a></section>
      <section class="osce-panel osce-start-card"><span class="osce-eyebrow">Fallback</span><h2>Lokaler Timer</h2><p>Timer nur auf diesem Prüfergerät. Keine Synchronisation mit weiteren Geräten.</p><a class="osce-button osce-button--secondary" href={`/medcases/osce/${item.id}/examiner/?mode=local`}>Mit lokalem Timer starten</a></section>
    </div>
  </div>
</StarlightPage>
