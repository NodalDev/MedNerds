---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import OsceMaster from '../../../../components/medcases/OsceMaster';
import OsceParticipant from '../../../../components/medcases/OsceParticipant';
import { forCandidate, forPatient, osceCases } from '../../../../data/medcases/cases';
import type { OsceCase, OsceRole } from '../../../../data/medcases/types';
import '../../../../styles/medcases.css';

const roleLabels: Record<OsceRole, string> = { examiner: 'Prüfer', candidate: 'Prüfling', patient: 'Schauspielpatient' };
export function getStaticPaths() {
  return osceCases.flatMap((item) => (['examiner', 'candidate', 'patient'] as const).map((role) => ({
    params: { caseId: item.id, role }, props: { item, role },
  })));
}
interface Props { item: OsceCase; role: OsceRole }
const { item, role } = Astro.props;
---

<StarlightPage hasSidebar={false} frontmatter={{
  title: role === 'candidate' ? 'OSCE-Station · Prüfling' : `${item.title} · ${roleLabels[role]}`,
  description: `OSCE-Rollenansicht für ${roleLabels[role]}.`,
  pageLayout: 'hub',
  tableOfContents: false,
  pagefind: false,
  head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, nofollow' } }],
}}>
  <div class="osce">
    {role === 'candidate' && <nav class="osce-breadcrumb" aria-label="Brotkrumennavigation"><a href="/medcases/">MedCases</a><span aria-hidden="true">›</span><a href="/medcases/session/candidate/">Session beitreten</a><span aria-hidden="true">›</span><span>OSCE-Station</span></nav>}
    {role === 'examiner' && <nav class="osce-breadcrumb" aria-label="Brotkrumennavigation"><a href="/medcases/">MedCases</a><span aria-hidden="true">›</span><a href="/medcases/osce/">OSCE trainieren</a><span aria-hidden="true">›</span><a href={`/medcases/osce/${item.id}/`}>{item.title}</a><span aria-hidden="true">›</span><span>Prüfer</span></nav>}
    {role === 'examiner' && <OsceMaster item={item} client:load />}
    {role === 'candidate' && <OsceParticipant role="candidate" item={forCandidate(item)} />}
    {role === 'patient' && <OsceParticipant role="patient" item={forPatient(item)} />}
  </div>
</StarlightPage>
