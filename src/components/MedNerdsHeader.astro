---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import { getActiveProduct, productLinks } from '../data/product-navigation';

const pathname = Astro.url.pathname;
const activeProduct = getActiveProduct(pathname);
---

<div
  class="mednerds-header"
  data-product={activeProduct?.href.split('/')[1] ?? 'mednerds'}
>
  <!-- ========================================
       Primärer Header
       ======================================== -->

  <div class="primary-row">
    <div class="primary-inner">
      <DefaultHeader>
        <slot />
      </DefaultHeader>
    </div>
  </div>

  <!-- ========================================
       Produktnavigation
       ======================================== -->

  <nav class="product-nav" aria-label="MedNerds Bereiche">
    <div class="desktop-product-links sl-flex">
      {
        productLinks.map(({ label, href }) => {
          const isActive = pathname.startsWith(href);

          return (
            <a
              href={href}
              data-product={href.split('/')[1]}
              class:list={{
                'product-link': true,
                active: isActive,
              }}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          );
        })
      }
    </div>
  </nav>
</div>

<script>
  const desktopProductNav = window.matchMedia('(min-width: 50rem)');
  const root = document.documentElement;
  const header = document.querySelector('.mednerds-header');

  let lastScrollY = Math.max(window.scrollY, 0);
  let accumulatedDistance = 0;
  let currentDirection = 0;
  let animationFrame = 0;

  const setProductNavHidden = (hidden: boolean) => {
    const shouldHide = desktopProductNav.matches && window.scrollY > 24 && hidden;
    root.toggleAttribute('data-product-nav-hidden', shouldHide);
  };

  const resetScrollState = () => {
    lastScrollY = Math.max(window.scrollY, 0);
    accumulatedDistance = 0;
    currentDirection = 0;

    if (!desktopProductNav.matches || lastScrollY <= 24) {
      setProductNavHidden(false);
    }
  };

  const updateProductNav = () => {
    animationFrame = 0;

    const scrollY = Math.max(window.scrollY, 0);
    const delta = scrollY - lastScrollY;

    if (scrollY <= 24) {
      setProductNavHidden(false);
      resetScrollState();
      return;
    }

    if (Math.abs(delta) < 1) return;

    const nextDirection = Math.sign(delta);

    if (nextDirection !== currentDirection) {
      currentDirection = nextDirection;
      accumulatedDistance = 0;
    }

    accumulatedDistance += Math.abs(delta);
    lastScrollY = scrollY;

    if (currentDirection > 0 && scrollY > 80 && accumulatedDistance >= 28) {
      setProductNavHidden(true);
      accumulatedDistance = 0;
    } else if (currentDirection < 0 && accumulatedDistance >= 18) {
      setProductNavHidden(false);
      accumulatedDistance = 0;
    }
  };

  const queueProductNavUpdate = () => {
    if (animationFrame) return;
    animationFrame = window.requestAnimationFrame(updateProductNav);
  };

  window.addEventListener('scroll', queueProductNavUpdate, { passive: true });
  desktopProductNav.addEventListener('change', resetScrollState);
  header?.addEventListener('focusin', () => setProductNavHidden(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') setProductNavHidden(false);
  });

  resetScrollState();
  root.setAttribute('data-product-nav-ready', '');
</script>

<style>
  /* ========================================
     Gesamter MedNerds Header
     ======================================== */

  .mednerds-header {
    display: grid;
    grid-template-rows: minmax(0, 1fr);

    height: 100%;
    min-width: 0;
  }

  /* ========================================
     Primäre Header-Zeile
     ======================================== */

  .primary-row {
    min-width: 0;
  }

  /*
   * Gemeinsame innere Seitenbreite.
   *
   * Logo und Theme-Button rücken dadurch
   * symmetrisch vom Browserrand nach innen.
   */
  .primary-inner {
    box-sizing: border-box;

    width: 100%;
    max-width: var(--mn-shell-max-width);

    height: 100%;

    margin-inline: auto;

    padding-inline:
      var(--mn-shell-padding-x);

    min-width: 0;
  }

  /*
   * Starlights Header besteht intern aus:
   *
   * 1. SiteTitle
   * 2. Search
   * 3. rechter Gruppe (Theme etc.)
   *
   * Wir geben diesen drei Bereichen eine
   * stabile Geometrie.
   */
  .primary-inner :global(.header) {
    width: 100%;
    min-width: 0;
  }

  .primary-inner :global(starlight-theme-select select:focus),
  .primary-inner :global(starlight-theme-select select:focus-visible),
  .primary-inner :global(starlight-theme-select select:active) {
    outline: none;
    box-shadow: none;
  }

  /* ========================================
     Produktnavigation
     ======================================== */

  .product-nav {
    display: none;
    min-width: 0;
    width: calc(100% + 2 * var(--sl-nav-pad-x));
    margin-inline: calc(-1 * var(--sl-nav-pad-x));
    padding-inline: var(--sl-nav-pad-x);
    overflow: hidden;

    border-top:
      1px solid
      var(--sl-color-hairline);

    background: var(--sl-color-bg-nav);

    opacity: 1;
    transform: translateY(0);
    visibility: visible;

    transition:
      transform 200ms cubic-bezier(0.2, 0, 0, 1),
      opacity 160ms ease,
      visibility 0s linear;
  }

  .desktop-product-links {
    height: 100%;
  }

  .product-link {
    position: relative;

    display: inline-flex;
    flex: 0 0 auto;

    align-items: center;

    margin-block: 0.35rem;

    padding:
      0
      0.75rem;

    border: 1px solid transparent;
    border-radius: 0.55rem;

    color:
      var(--sl-color-gray-2);

    font-size:
      var(--sl-text-base);

    font-weight: 600;

    text-decoration: none;

    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .product-link:hover {
    color:
      var(--product-color);

    background:
      color-mix(
        in oklch,
        var(--product-color) 6%,
        transparent
      );

    border-color:
      color-mix(
        in oklch,
        var(--product-color) 18%,
        transparent
      );
  }

  .product-link:focus-visible {
    outline: 2px solid var(--product-color);
    outline-offset: 2px;
  }

  .product-link.active {
    color:
      var(--product-color);

    background:
      color-mix(
        in oklch,
        var(--product-color) 10%,
        transparent
      );

    border-color:
      color-mix(
        in oklch,
        var(--product-color) 28%,
        transparent
      );
  }

  /* ========================================
     Desktop
     ======================================== */

  @media (min-width: 50rem) {
    .mednerds-header {
      grid-template-rows: 4.35rem 3.15rem;

      transition:
        grid-template-rows
        200ms
        cubic-bezier(0.2, 0, 0, 1);
    }

    .product-nav {
      display: block;
    }

    /*
     * Überschreibt Starlights dynamische
     * Header-Spaltenberechnung.
     *
     * Links:
     * MedNerds + ggf. Produktlogo.
     *
     * Mitte:
     * Suche mit stabiler Breite.
     *
     * Rechts:
     * Theme-Button.
     *
     * Wichtig:
     * Die Breite des Produktlogos beeinflusst
     * dadurch NICHT mehr die Position der Suche.
     */
    .primary-inner :global(.header) {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        minmax(18rem, 22rem)
        auto;

      align-items: center;

      gap:
        clamp(
          1rem,
          2vw,
          2rem
        );
    }

    /*
     * Zweiter Bereich des DefaultHeaders:
     * Search.
     *
     * Rechtsbündig innerhalb seiner festen
     * Grid-Spalte.
     */
    .primary-inner
      :global(.header > div:nth-child(2)) {
      width: 100%;

      min-width: 0;

      justify-self: end;
      justify-content: flex-end;
    }

    /*
     * Starlight gibt dem Search-Button bereits
     * max-width: 22rem.
     *
     * Die Wrapper-Spalte besitzt ebenfalls
     * maximal 22rem, deshalb bleibt sie stabil.
     */
    .primary-inner
      :global(.header > div:nth-child(2) site-search) {
      width: 100%;
    }

    /*
     * Rechte Gruppe:
     * Theme-/Language-/Social-Bereich bleibt
     * immer am rechten Shell-Rand.
     */
    .primary-inner
      :global(.header > .right-group) {
      justify-self: end;
    }

    /* Platz für die längste übersetzte Option statt Starlights fester Breite.
     * Die rechtsbündige Grid-Spalte wächst dabei ausschließlich nach links.
     */
    .primary-inner :global(starlight-theme-select select) {
      width: auto;
    }

    .desktop-product-links {
      align-items: center;

      gap: 0.1rem;
    }

    :global(html[data-product-nav-hidden]) {
      --sl-nav-height: 4.35rem;
    }

    :global(html[data-product-nav-hidden]) .mednerds-header {
      grid-template-rows: 4.35rem 0;
    }

    :global(html[data-product-nav-hidden]) .product-nav {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.65rem);
      visibility: hidden;

      transition-delay: 0s, 0s, 200ms;
    }

    :global(html[data-product-nav-ready] .page > .header) {
      transition:
        height
        200ms
        cubic-bezier(0.2, 0, 0, 1);
    }

    :global(html[data-product-nav-ready] .main-frame) {
      transition:
        padding-top
        200ms
        cubic-bezier(0.2, 0, 0, 1);
    }

    :global(html[data-product-nav-ready] .sidebar) {
      transition:
        top 200ms cubic-bezier(0.2, 0, 0, 1),
        height 200ms cubic-bezier(0.2, 0, 0, 1),
        width 240ms cubic-bezier(0.2, 0, 0, 1);
    }

    :global(
      html[data-product-nav-ready]
        .right-sidebar-container
        > .right-sidebar
    ) {
      transition:
        top 200ms cubic-bezier(0.2, 0, 0, 1),
        max-height 200ms cubic-bezier(0.2, 0, 0, 1);
    }
  }

  /* ========================================
     Große Desktop-Ansicht
     ======================================== */

  /* Die breite Suche erst anzeigen, wenn auch beide Wortmarken Platz haben. */
  @media (min-width: 50rem) and (max-width: 71.999rem) {
    .primary-inner :global(.header) {
      grid-template-columns: minmax(0, 1fr) 2.5rem auto;
      gap: 1rem;
    }
  }

  @media (max-width: 71.999rem) {
    .primary-inner :global(site-search button[data-open-modal]) {
      width: 2.5rem;
      padding: 0;
      justify-content: center;
      border: 0;
      background: transparent;
      font-size: var(--sl-text-xl);
    }

    .primary-inner :global(site-search button[data-open-modal] > span),
    .primary-inner :global(site-search button[data-open-modal] > kbd) {
      display: none;
    }
  }

  @media (max-width: 49.999rem) {
    .primary-inner {
      padding-inline: 0;
    }

    .primary-inner :global(site-search > button[data-open-modal]) {
      display: none;
    }
  }

  @media (min-width: 72rem) {
    /*
     * Produktnavigation vorerst unverändert.
     *
     * Diese ziehen wir erst im nächsten Schritt
     * auf dieselbe Shell-Breite.
     */
    .desktop-product-links {
      padding-inline-start:
        calc(
          var(--sl-sidebar-width) +
          0.35rem
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mednerds-header,
    .product-nav,
    .product-link,
    :global(html[data-product-nav-ready] .page > .header),
    :global(html[data-product-nav-ready] .main-frame),
    :global(html[data-product-nav-ready] .sidebar),
    :global(
      html[data-product-nav-ready]
        .right-sidebar-container
        > .right-sidebar
    ) {
      transition: none;
    }
  }
</style>
