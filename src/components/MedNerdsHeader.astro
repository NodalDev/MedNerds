---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';

const pathname = Astro.url.pathname;
const productLinks = [
  { label: 'MedDocs', href: '/meddocs/', product: 'meddocs' },
  { label: 'MedBlog', href: '/medblog/', product: 'medblog' },
  { label: 'MedLearn', href: '/medlearn/', product: 'medlearn' },
  { label: 'MedCases', href: '/medcases/', product: 'medcases' },
  { label: 'MedTools', href: '/medtools/', product: 'medtools' },
  { label: 'MedNerds Basel', href: '/mednerds-basel/', product: 'mednerds-basel' },
] as const;

const activeProduct = productLinks.find(({ href }) => pathname.startsWith(href));
---

<div class="mednerds-header" data-product={activeProduct?.href.split('/')[1] ?? 'mednerds'}>
  <div class="primary-row">
    <DefaultHeader><slot /></DefaultHeader>
  </div>

  <nav class="product-nav" aria-label="MedNerds Bereiche">
    <div class="desktop-product-links sl-hidden md:sl-flex">
      {
        productLinks.map(({ label, href }) => {
          const isActive = pathname.startsWith(href);
          return (
            <a
              href={href}
              data-product={href.split('/')[1]}
              class:list={{ 'product-link': true, active: isActive }}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          );
        })
      }
    </div>

    <mednerds-product-switcher class="mobile-product-switcher sl-flex md:sl-hidden">
      <label for="mednerds-product-select">Bereich</label>
      <div class="mobile-product-control">
        <div class="mobile-product-label" aria-hidden="true">
          <span>{activeProduct?.label ?? 'Startseite'}</span>
          <span class="select-chevron">⌄</span>
        </div>
        <select id="mednerds-product-select" aria-label="MedNerds Bereich auswählen">
          <option value="/" selected={!activeProduct}>Startseite</option>
          {
            productLinks.map(({ label, href }) => (
              <option value={href} selected={activeProduct?.href === href}>{label}</option>
            ))
          }
        </select>
      </div>
    </mednerds-product-switcher>
  </nav>
</div>

<script>
  class MedNerdsProductSwitcher extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      select?.addEventListener('change', () => {
        window.location.href = select.value;
      });
    }
  }

  if (!customElements.get('mednerds-product-switcher')) {
    customElements.define('mednerds-product-switcher', MedNerdsProductSwitcher);
  }
</script>

<style>
  .mednerds-header {
    display: grid;
    grid-template-rows: 4.35rem 3.15rem;
    height: 100%;
    min-width: 0;
  }

  .primary-row {
    min-width: 0;
  }

  .product-nav {
    min-width: 0;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .desktop-product-links {
    height: 100%;
  }

  .product-link {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    padding: 0 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-base);
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .product-link:hover {
    color: var(--product-color);
    background: color-mix(in srgb, var(--product-color) 8%, transparent);
  }

  .product-link.active {
    color: var(--product-color);
  }

  .product-link.active::after {
    position: absolute;
    right: 0.55rem;
    bottom: 0;
    left: 0.55rem;
    height: 2px;
    border-radius: 999px 999px 0 0;
    background: var(--product-color);
    content: '';
  }

  .mobile-product-switcher {
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }

  .mobile-product-switcher label {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-product-control {
    position: relative;
    min-width: 0;
    height: 2.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
  }

  .mobile-product-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    padding: 0 0.75rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
  }

  .select-chevron {
    line-height: 1;
  }

  .mobile-product-switcher select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    font: inherit;
  }

  .mobile-product-control:focus-within {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (min-width: 50rem) {
    .desktop-product-links {
      align-items: stretch;
      gap: 0.1rem;
    }
  }

  @media (min-width: 72rem) {
    .desktop-product-links {
      padding-inline-start: calc(var(--sl-sidebar-width) + 0.35rem);
    }
  }
</style>
