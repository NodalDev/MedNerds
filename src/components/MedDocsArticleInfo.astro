---
import { articleDateTime, formatArticleDate, type ArticleMetadata } from '../lib/meddocs/article-metadata';

interface Props {
  metadata: ArticleMetadata;
}

const { metadata } = Astro.props;
---

<section class="article-info" aria-labelledby="article-info-heading">
  <h2 id="article-info-heading">Über diesen Artikel</h2>
  <dl>
    <div>
      <dt>{metadata.authors.length === 1 ? 'Autor' : 'Autoren'}</dt>
      {metadata.authors.map(({ name, description }) => (
        <dd class="person">
          <span class="person-name">{name}</span>
          <p>{description}</p>
        </dd>
      ))}
    </div>
    {metadata.reviewers.length > 0 && (
      <div>
        <dt>Fachliche Prüfung</dt>
        {metadata.reviewers.map(({ name, description }) => (
          <dd class="person">
            <span class="person-name">{name}</span>
            <p>{description}</p>
          </dd>
        ))}
      </div>
    )}
    <div>
      <dt>Erstveröffentlichung</dt>
      <dd><time datetime={articleDateTime(metadata.published)}>{formatArticleDate(metadata.published)}</time></dd>
    </div>
    {metadata.updated && (
      <div>
        <dt>Letzte Aktualisierung</dt>
        <dd><time datetime={articleDateTime(metadata.updated)}>{formatArticleDate(metadata.updated)}</time></dd>
      </div>
    )}
    <div class="license">
      <dt>Lizenz</dt>
      <dd>
        <a href={metadata.license.url} rel="license">{metadata.license.label}</a>
        <p>{metadata.license.fullName}</p>
      </dd>
    </div>
  </dl>
</section>

<style>
  .article-info {
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  h2 {
    margin: 0 0 1.25rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: 1.4;
  }

  dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 2rem;
    margin: 0;
  }

  dl > div {
    min-width: 0;
  }

  dt {
    margin-block-end: 0.375rem;
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }

  dd {
    margin: 0;
  }

  p {
    margin: 0.25rem 0 0;
  }

  .person + .person {
    margin-block-start: 0.875rem;
  }

  .person-name {
    color: var(--sl-color-white);
    font-weight: 500;
  }

  a {
    color: var(--sl-color-accent);
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--sl-color-accent-high);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @media (min-width: 50rem) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .license {
      grid-column: 1 / -1;
    }
  }
</style>
