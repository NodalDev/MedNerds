---
import MedNerdsIcon from './MedNerdsIcon.astro';
import { sidebarIcons } from '../data/sidebar-icons';

const principles = [
  { label: 'Strukturiert lernen', icon: 'tabler:book' },
  { label: 'Zusammenhänge verstehen', icon: 'tabler:route' },
  { label: 'Schnell nachschlagen', icon: 'tabler:search' },
  { label: 'Fachgebietsübergreifend orientieren', icon: 'tabler:compass' },
] as const;

const topics = [
  {
    title: 'EKG',
    href: '/meddocs/ekg/',
    description: 'Ableitungen, Herzrhythmus und die systematische Interpretation des EKG.',
  },
  {
    title: 'Echokardiographie',
    href: '/meddocs/echokardiographie/',
    description: 'Anatomie, Schallfenster und Grundlagen der Beurteilung von Herzstruktur und Funktion.',
  },
  {
    title: 'Sonographie',
    href: '/meddocs/sonographie/',
    description: 'Untersuchungstechnik, Orientierung im Ultraschallbild und typische Befunde.',
  },
  {
    title: 'Notfallmedizin',
    href: '/meddocs/notfallmedizin/',
    description: 'Strukturierte Ersteinschätzung, akute Krankheitsbilder und Grundlagen der Versorgung.',
  },
] as const satisfies readonly {
  title: keyof typeof sidebarIcons;
  href: string;
  description: string;
}[];
---

<div class="meddocs-hub not-content">
  <div class="hub-intro">
    <p class="hub-lead">
      Strukturiertes medizinisches Wissen zum Lernen, Verstehen und schnellen Nachschlagen.
    </p>
    <p class="hub-description">
      Das offene medizinische Nachschlagewerk von MedNerds verbindet Grundlagen,
      Diagnostik und klinische Zusammenhänge.
    </p>
  </div>

  <section class="hub-principles" aria-labelledby="hub-principles-title">
    <h2 id="hub-principles-title">Wofür MedDocs da ist</h2>
    <ul class="principle-list" role="list">
      {principles.map(({ label, icon }) => (
        <li>
          <MedNerdsIcon name={icon} size="md" />
          <span>{label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="hub-topics" aria-labelledby="hub-topics-title">
    <div class="hub-section-heading">
      <h2 id="hub-topics-title">Fachgebiete</h2>
      <p>Diese vier Bereiche stehen aktuell im Fokus.</p>
    </div>
    <ul class="topic-grid" role="list">
      {topics.map(({ title, href, description }, index) => (
        <li>
          <a class="topic-card" href={href} aria-labelledby={`hub-topic-${index}`}>
            <span class="topic-icon">
              <MedNerdsIcon name={sidebarIcons[title]} size="xl" />
            </span>
            <h3 id={`hub-topic-${index}`}>{title}</h3>
            <p>{description}</p>
            <span class="topic-link" aria-hidden="true">
              Bereich öffnen
              <MedNerdsIcon name="tabler:arrow-right" size="sm" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <p class="hub-note">
    MedDocs wird kontinuierlich erweitert. Die Inhalte befinden sich im Aufbau
    und werden schrittweise ergänzt und redaktionell geprüft.
  </p>
</div>

<style>
  .meddocs-hub {
    container-type: inline-size;
    color: var(--sl-color-gray-2);
  }

  .meddocs-hub :is(h2, h3, p, ul) {
    margin: 0;
  }

  .hub-intro {
    display: grid;
    gap: 0.75rem;
  }

  .hub-lead {
    max-width: 48ch;
    color: var(--sl-color-white);
    font-size: clamp(1.125rem, 2.3vw, 1.375rem);
    font-weight: 500;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hub-description {
    max-width: 65ch;
    line-height: 1.65;
  }

  .hub-principles {
    margin-block: 1.75rem 2.5rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--sl-color-hairline);
  }

  .hub-principles h2 {
    margin-bottom: 1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .principle-list,
  .topic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
    list-style: none;
  }

  .principle-list {
    gap: 1rem 1.5rem;
  }

  .principle-list li {
    display: flex;
    align-items: start;
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .principle-list :global(.mn-icon) {
    margin-top: 0.0625rem;
    color: var(--sl-color-accent);
  }

  .hub-section-heading {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .hub-section-heading h2 {
    color: var(--sl-color-white);
    font-size: 1.375rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .hub-section-heading p {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .topic-grid {
    gap: 1rem;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--mn-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .topic-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.25rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
    color: var(--sl-color-accent);
  }

  .topic-card h3 {
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--sl-color-white);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .topic-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .topic-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--sl-color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .topic-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .topic-card:hover {
      border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-hairline));
      background: var(--mn-surface-hover);
    }
  }

  .meddocs-hub .hub-note {
    margin-top: 1.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @container (min-width: 26rem) {
    .principle-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 34rem) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 52rem) {
    .principle-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-card {
      transition: none;
    }
  }
</style>
