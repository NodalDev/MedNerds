---
import { publicCases } from '../../data/medcases/cases';
import { validTimerConfig } from '../../lib/medcases/timer';
import '../../styles/medcases.css';
---

<div class="osce osce-hub">
  <nav class="osce-breadcrumb" aria-label="Brotkrumennavigation"><a href="/medcases/">MedCases</a><span aria-hidden="true">›</span><span>Fall wählen</span></nav>
  <p class="osce-hub__lead">Wähle einen OSCE-Fall aus und starte ihn als Prüfer. Suche nach kategorien oder entscheide dich für einen zufälligen Fall.</p>
  <section aria-labelledby="osce-faelle">
    <div class="osce-section-heading"><h2 id="osce-faelle">Verfügbare OSCE-Fälle</h2><span class="osce-muted">{publicCases.length} Demo-Fall</span></div>
    <div class="osce-case-grid">
      {publicCases.map((item) => <a class="osce-case-card" href={`/medcases/osce/${item.id}/`}>
        <span class="osce-eyebrow">{item.specialty} · {item.demo ? 'Demo / Testfall' : 'OSCE'}</span>
        <strong>{item.title}</strong>
        <span>{item.summary}</span>
        <span class="osce-case-card__meta">{validTimerConfig(item.timer) ? `${item.timer.durationSeconds / 60} Minuten` : 'Dauer offen'}</span>
        <span class="osce-case-card__link">Fall ansehen <span aria-hidden="true">→</span></span>
      </a>)}
    </div>
  </section>
</div>
