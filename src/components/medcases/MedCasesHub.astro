---
import MedNerdsIcon from '../MedNerdsIcon.astro';
import '../../styles/medcases.css';
---

<div class="osce osce-hub">
  <div class="osce-entry-grid">
    <section class="osce-panel osce-entry-card">
      <h2>OSCE starten</h2>
      <span class="osce-entry-card__icon" aria-hidden="true"><MedNerdsIcon name="tabler:clipboard-text" size="xl" /></span>
      <p>Wähle einen Fall aus unseren Kategorien aus oder lasse dich überraschen und starte ihn als Prüfer.</p>
      <a class="osce-button" href="/medcases/osce/">Fälle ansehen</a>
    </section>
    <section class="osce-panel osce-entry-card">
      <h2>Session beitreten</h2>
      <span class="osce-entry-card__icon" aria-hidden="true"><MedNerdsIcon name="tabler:users-plus" size="xl" /></span>
      <p>Scanne den QR-Code des Prüfers oder gib den Session-Code ein.</p>
      <form action="/medcases/session/candidate/" method="get" class="osce-entry-form">
        <label class="sr-only" for="medcases-session-code">Session-Code</label>
        <div class="osce-join__row">
          <input id="medcases-session-code" name="code" class="osce-input osce-code-input" type="text" placeholder="Session-Code"
            autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="16" required />
          <button class="osce-button osce-button--secondary" type="submit">Beitreten</button>
        </div>
      </form>
    </section>
  </div>
</div>
