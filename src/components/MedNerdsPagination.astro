---
import DefaultPagination from '@astrojs/starlight/components/Pagination.astro';
import ArticleActions from './ArticleActions';

const pathname = Astro.url.pathname;
const isMedDocs = pathname.startsWith('/meddocs/');
---

{
  isMedDocs && (
    <div class="meddocs-tools">
      <ArticleActions client:load />
    </div>
  )
}

<DefaultPagination />

<style>
  .meddocs-tools {
    display: flex;
    justify-content: flex-end;

    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
</style>