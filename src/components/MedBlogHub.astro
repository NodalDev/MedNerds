---
import MedBlogCard from './MedBlogCard.astro';
import { medBlogTypes, medBlogTypeIds, medBlogAreas, medBlogAreaIds, type MedBlogType } from '../data/medblog';
import { getMedBlogPosts } from '../lib/medblog/posts';

interface Props { type?: MedBlogType; }
const { type } = Astro.props;
const posts = await getMedBlogPosts({ type });
const groups = [
  { id: 'featured', title: 'Ausgewählt', variant: 'featured', posts: posts.filter(({ data }) => data.featured) },
  { id: 'latest', title: 'Neueste Beiträge', variant: 'standard', posts: posts.filter(({ data }) => !data.featured && data.type !== 'update') },
  { id: 'updates', title: medBlogTypes.update.plural, variant: 'compact', posts: posts.filter(({ data }) => !data.featured && data.type === 'update') },
] as const;
---

<medblog-hub class="medblog-hub not-content" data-fixed-type={type}>
  <div class="blog-intro">
    {type && <a class="back-link" href="/medblog/">← Alle Beiträge in MedBlog</a>}
    <p class="blog-lead">Neuigkeiten, Hintergründe und Updates aus MedNerds.</p>
  </div>

  <nav class="type-pages" aria-label="Beitragsübersichten">
    <a href="/medblog/" aria-current={!type ? 'page' : undefined}>Alle Beiträge</a>
    {medBlogTypeIds.map((id) => <a href={`/medblog/${medBlogTypes[id].segment}/`} aria-current={type === id ? 'page' : undefined}>{medBlogTypes[id].plural}</a>)}
  </nav>

  <div class="blog-filters" hidden>
    {!type && (
      <fieldset data-filter="type">
        <legend>Beitragstyp</legend>
        <div class="filter-options">
          <button type="button" data-value="all" aria-pressed="true">Alle</button>
          {medBlogTypeIds.map((id) => <button type="button" data-value={id} aria-pressed="false">{medBlogTypes[id].plural}</button>)}
        </div>
      </fieldset>
    )}
    <fieldset data-filter="area">
      <legend>Bereich</legend>
      <div class="filter-options">
        <button type="button" data-value="all" aria-pressed="true">Alle Bereiche</button>
        {medBlogAreaIds.map((id) => <button type="button" data-value={id} aria-pressed="false">{medBlogAreas[id].label}</button>)}
      </div>
    </fieldset>
    <p class="filter-status" role="status" aria-live="polite" aria-atomic="true">{posts.length} Beiträge</p>
  </div>

  {groups.filter((group) => group.posts.length > 0).map((group) => (
    <section class="blog-section" data-blog-group aria-labelledby={`blog-${group.id}`}>
      <h2 id={`blog-${group.id}`}>{group.title}</h2>
      <div class:list={['blog-grid', `blog-grid--${group.variant}`]}>
        {group.posts.map((post) => <MedBlogCard post={post} variant={group.variant} />)}
      </div>
    </section>
  ))}
  <p class="empty-state" data-empty hidden={posts.length > 0}>Für diese Filterkombination wurden keine Beiträge gefunden.</p>
</medblog-hub>

<script>
  import { medBlogTypeIds, medBlogAreaIds, type MedBlogType, type MedBlogArea } from '../data/medblog';

  class MedBlogHub extends HTMLElement {
    private listeners?: AbortController;

    connectedCallback() {
      this.listeners?.abort();
      const listeners = this.listeners = new AbortController();
      const cards = Array.from(this.querySelectorAll<HTMLElement>('[data-blog-post]'));
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-filter] button'));
      const groups = this.querySelectorAll<HTMLElement>('[data-blog-group]');
      const empty = this.querySelector<HTMLElement>('[data-empty]');
      const status = this.querySelector<HTMLElement>('[role="status"]');
      const fixedType = this.dataset.fixedType as MedBlogType | undefined;
      let type: MedBlogType | 'all' = fixedType ?? 'all';
      let area: MedBlogArea | 'all' = 'all';

      const apply = () => {
        let count = 0;
        for (const card of cards) {
          const matches = (type === 'all' || card.dataset.type === type)
            && (area === 'all' || card.dataset.areas?.split(' ').includes(area));
          card.hidden = !matches;
          if (matches) count++;
        }
        for (const group of groups) group.hidden = !group.querySelector('[data-blog-post]:not([hidden])');
        for (const button of buttons) {
          const value = button.closest<HTMLElement>('[data-filter]')?.dataset.filter === 'type' ? type : area;
          button.setAttribute('aria-pressed', String(button.dataset.value === value));
        }
        if (empty) empty.hidden = count > 0;
        if (status) status.textContent = `${count} ${count === 1 ? 'Beitrag' : 'Beiträge'}`;
      };

      const readUrl = () => {
        const query = new URLSearchParams(location.search);
        const queryType = query.get('type');
        const queryArea = query.get('area');
        type = fixedType ?? (medBlogTypeIds.includes(queryType as MedBlogType) ? queryType as MedBlogType : 'all');
        area = medBlogAreaIds.includes(queryArea as MedBlogArea) ? queryArea as MedBlogArea : 'all';
        apply();
      };

      this.addEventListener('click', (event) => {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-filter] button') : null;
        if (!button || !this.contains(button)) return;
        const filter = button.closest<HTMLElement>('[data-filter]')?.dataset.filter;
        if (filter === 'type') type = button.dataset.value as MedBlogType | 'all';
        else if (filter === 'area') area = button.dataset.value as MedBlogArea | 'all';
        else return;
        const url = new URL(location.href);
        if (!fixedType && type !== 'all') url.searchParams.set('type', type);
        else url.searchParams.delete('type');
        if (area !== 'all') url.searchParams.set('area', area);
        else url.searchParams.delete('area');
        if (url.href !== location.href) history.pushState(null, '', url);
        apply();
      }, { signal: listeners.signal });
      window.addEventListener('popstate', readUrl, { signal: listeners.signal });
      readUrl();
      this.querySelector<HTMLElement>('.blog-filters')?.removeAttribute('hidden');
      // Without JavaScript these links still provide working type overviews.
      this.querySelector<HTMLElement>('.type-pages')?.toggleAttribute('hidden', !fixedType);
    }

    disconnectedCallback() { this.listeners?.abort(); }
  }
  if (!customElements.get('medblog-hub')) customElements.define('medblog-hub', MedBlogHub);
</script>

<style>
  .medblog-hub { display: block; color: var(--sl-color-gray-2); }
  p, h2 { margin: 0; }
  .blog-intro { display: grid; gap: 0.5rem; max-width: 65ch; }
  .blog-lead { color: var(--sl-color-white); font-size: 1.25rem; line-height: 1.5; }
  .blog-description { font-size: var(--sl-text-sm); line-height: 1.65; }
  .back-link { margin-bottom: 0.5rem; font-size: var(--sl-text-sm); color: var(--sl-color-accent); text-underline-offset: 0.2em; }
  .type-pages { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-block: 1.5rem; }
  .type-pages a { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); text-decoration: none; padding-block: 0.375rem; border-bottom: 2px solid transparent; }
  .type-pages a[aria-current] { color: var(--sl-color-accent); border-color: currentColor; }
  .blog-filters { padding-block: 1.25rem; border-block: 1px solid var(--sl-color-hairline); }
  .blog-filters[hidden], .type-pages[hidden], .blog-section[hidden], .empty-state[hidden] { display: none; }
  fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  fieldset + fieldset { margin-top: 1rem; }
  legend { padding: 0; margin-bottom: 0.5rem; font-size: var(--sl-text-xs); font-weight: 600; color: var(--sl-color-gray-3); }
  .filter-options { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  button { min-height: 2.75rem; padding: 0.5rem 0.875rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; background: var(--mn-surface); color: var(--sl-color-gray-2); font: inherit; font-size: var(--sl-text-sm); cursor: pointer; }
  button[aria-pressed='true'] { border-color: var(--sl-color-accent); color: var(--sl-color-accent-high); background: var(--sl-color-accent-low); font-weight: 600; }
  button:hover { border-color: var(--sl-color-accent); }
  :is(button, a):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  .filter-status { margin-top: 0.875rem; color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
  .blog-section { margin-top: 2rem; }
  h2 { margin-bottom: 1rem; color: var(--sl-color-white); font-size: 1.25rem; font-weight: 600; }
  .blog-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .blog-grid--standard { grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .empty-state { margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; font-size: var(--sl-text-sm); line-height: 1.6; }
</style>
