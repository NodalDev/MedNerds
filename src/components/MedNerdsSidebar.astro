---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import MedNerdsIcon from './MedNerdsIcon.astro';
import { sidebarIcons } from '../data/sidebar-icons';
import medNerdsOverviewIcon from '../assets/Logos/MedNerds - icon.webp?url';
import { withSidebarBadges } from '../data/sidebar-badges';

const isMedDocs = Astro.url.pathname.startsWith('/meddocs/');

if (isMedDocs) {
  const route = Astro.locals.starlightRoute;
  route.sidebar = withSidebarBadges(route.sidebar, route.lang);
}
---

<script is:inline>
  try {
    if (window.location.pathname.startsWith('/meddocs/')) {
      const preference = localStorage.getItem('mednerds-sidebar-collapsed');
      const isCompactDesktop = window.matchMedia(
        '(min-width: 50rem) and (max-width: 89.999rem)'
      ).matches;
      const shouldCollapse = preference === null
        ? isCompactDesktop
        : preference === 'true';

      document.documentElement.classList.toggle(
        'mn-sidebar-collapsed',
        shouldCollapse
      );
    }
  } catch {}
</script>

<DefaultSidebar {...Astro.props}>
  <slot />
</DefaultSidebar>

{Object.entries(sidebarIcons).map(([label, name]) => (
  <template data-sidebar-icon={label}>
    {
      label === 'Übersicht' ? (
        <img
          src={medNerdsOverviewIcon}
          width="513"
          height="512"
          alt=""
          aria-hidden="true"
          draggable="false"
          class="mn-sidebar-icon mn-sidebar-brand-icon"
        />
      ) : (
        <MedNerdsIcon
          name={name}
          size="md"
          class="mn-sidebar-icon"
        />
      )
    }
  </template>
))}

{isMedDocs && (
  <button
    type="button"
    class="mn-sidebar-toggle"
    aria-controls="starlight__sidebar"
    aria-expanded="true"
  >
    <span class="mn-sidebar-toggle-label">Einklappen</span>
    <MedNerdsIcon name="tabler:layout-sidebar-left-collapse" size="md" />
  </button>
)}

<script>
  // Text separat begrenzen, damit Icon, Badge und Caret ihren Platz behalten.
  function initialiseSidebarLabels() {
    const labels = document.querySelectorAll<HTMLElement>(
      '.sidebar-content .top-level > li > a > span:first-child, ' +
      '.sidebar-content .top-level > li > details > summary > .group-label > .large, ' +
      '.sidebar-content .group-label:has(> .mn-sidebar-badge) > .large, ' +
      '.sidebar-content a:has(> .mn-sidebar-badge) > span:first-child'
    );
    for (const label of labels) {
      if (label.querySelector('.mn-sidebar-label-text')) continue;
      const textNodes = Array.from(label.childNodes).filter((node) => node.nodeType === Node.TEXT_NODE);
      const text = document.createElement('span');
      text.className = 'mn-sidebar-label-text';
      label.title = textNodes.map((node) => node.textContent).join('').trim();
      for (const node of textNodes) text.append(node);
      label.append(text);
    }
  }

  // Enhance Starlight's existing labels without replacing its navigation markup.
  // The SVGs are built locally by Astro; this only places them next to the labels.
  function initialiseSidebarIcons() {
    const templates = Array.from(document.querySelectorAll<HTMLTemplateElement>('template[data-sidebar-icon]'));
    const labels = document.querySelectorAll<HTMLElement>(
      '.sidebar-content .top-level > li > a > span:first-child, ' +
      '.sidebar-content .top-level > li > details > summary > .group-label > .large'
    );
    for (const label of labels) {
      if (label.querySelector('.mn-sidebar-icon')) continue;
      const template = templates.find((item) => item.dataset.sidebarIcon === label.textContent?.trim());
      if (template) label.prepend(template.content.cloneNode(true));
    }
  }

  function getTopLevelDetails() {
    return Array.from(
      document.querySelectorAll(
        '.sidebar-content .top-level > li > details'
      )
    ).filter(
      (element): element is HTMLDetailsElement =>
        element instanceof HTMLDetailsElement
    );
  }

  function closeOtherTopLevelGroups(
    current: HTMLDetailsElement
  ) {
    let changed = false;
    for (const details of getTopLevelDetails()) {
      if (details !== current && details.open) {
        details.open = false;
        changed = true;
      }
    }
    if (changed) persistSidebarOpenState();
  }

  function closeAllTopLevelGroups() {
    let changed = false;
    for (const details of getTopLevelDetails()) {
      if (details.open) {
        details.open = false;
        changed = true;
      }
    }
    if (changed) persistSidebarOpenState();
  }

  function persistSidebarOpenState() {
    const scroller = document.getElementById('starlight__sidebar');
    const target = scroller?.querySelector<HTMLElement>('sl-sidebar-state-persist');
    if (!scroller || !target) return;

    const open: Array<boolean | null> = [];
    for (const restorePoint of target.querySelectorAll<HTMLElement>('sl-sidebar-restore')) {
      const index = Number.parseInt(restorePoint.dataset.index ?? '', 10);
      const details = restorePoint.closest('details');
      if (!Number.isNaN(index) && details instanceof HTMLDetailsElement) {
        open[index] = details.open;
      }
    }

    try {
      sessionStorage.setItem('sl-sidebar-state', JSON.stringify({
        hash: target.dataset.hash ?? '',
        open,
        scroll: scroller.scrollTop,
      }));
    } catch {}
  }

  function getOverviewLink(details: HTMLDetailsElement) {
    return Array.from(details.querySelectorAll<HTMLAnchorElement>(':scope > ul > li > a'))
      .find((link) => link.querySelector(':scope > span:first-child')?.textContent?.trim() === 'Übersicht');
  }

  function initialiseCollapsedGroupLinks() {
    for (const details of getTopLevelDetails()) {
      const overview = getOverviewLink(details);
      const summary = details.querySelector(':scope > summary');
      const icon = summary?.querySelector('.mn-sidebar-icon');
      const label = summary?.querySelector('.large')?.textContent?.trim();
      if (!overview || !icon || !label) continue;

      const previous = details.previousElementSibling;
      const link = previous instanceof HTMLAnchorElement && previous.classList.contains('mn-sidebar-collapsed-link')
        ? previous
        : document.createElement('a');
      link.className = 'mn-sidebar-collapsed-link';
      link.href = overview.href;
      link.title = `${label}: Übersicht`;
      link.setAttribute('aria-label', `Zur Übersicht von ${label}`);
      link.replaceChildren(icon.cloneNode(true));
      if (details.querySelector('a[aria-current="page"]')) {
        link.setAttribute('aria-current', window.location.pathname === overview.pathname ? 'page' : 'true');
      } else {
        link.removeAttribute('aria-current');
      }
      if (link !== previous) details.before(link);
    }
  }

  const SIDEBAR_COLLAPSED_KEY = 'mednerds-sidebar-collapsed';
  const desktopSidebar = window.matchMedia('(min-width: 50rem)');
  const compactDesktopSidebar = window.matchMedia(
    '(min-width: 50rem) and (max-width: 89.999rem)'
  );

  function getManualSidebarPreference() {
    try {
      const preference = localStorage.getItem(SIDEBAR_COLLAPSED_KEY);
      if (preference === 'true') return true;
      if (preference === 'false') return false;
    } catch {}

    return null;
  }

  function syncSidebarCollapsedState() {
    const manualPreference = getManualSidebarPreference();
    const collapsed = desktopSidebar.matches && (
      manualPreference ?? compactDesktopSidebar.matches
    );

    document.documentElement.classList.toggle(
      'mn-sidebar-collapsed',
      collapsed
    );
  }

  function isSidebarCollapsed() {
    return desktopSidebar.matches && document.documentElement.classList.contains('mn-sidebar-collapsed');
  }

  function updateSidebarToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('.mn-sidebar-toggle');
    if (!toggle) return;

    const collapsed = isSidebarCollapsed();
    const label = collapsed ? 'Ausklappen' : 'Einklappen';
    toggle.setAttribute('aria-expanded', String(!collapsed));
    toggle.setAttribute('aria-label', `Sidebar ${label.toLowerCase()}`);
    toggle.title = `Sidebar ${label.toLowerCase()}`;
    toggle.querySelector('.mn-sidebar-toggle-label')!.textContent = label;

    for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar-content .top-level > li > a')) {
      const text = link.querySelector('.mn-sidebar-label-text')?.textContent?.trim();
      if (text) {
        link.title = text;
        if (collapsed) link.setAttribute('aria-label', text);
        else link.removeAttribute('aria-label');
      }
    }

  }

  function setSidebarCollapsed(collapsed: boolean) {
    document.documentElement.classList.toggle('mn-sidebar-collapsed', collapsed);
    if (collapsed) closeAllTopLevelGroups();
    else initialiseSidebarAccordion();
    updateSidebarToggle();
    try {
      localStorage.setItem(SIDEBAR_COLLAPSED_KEY, String(collapsed));
    } catch {}
  }

  function initialiseCollapseControl() {
    const toggle = document.querySelector<HTMLButtonElement>('.mn-sidebar-toggle');
    if (!toggle) {
      document.documentElement.classList.remove('mn-sidebar-collapsed');
      return;
    }

    syncSidebarCollapsedState();
    updateSidebarToggle();
    if (toggle.dataset.mednerdsCollapse !== 'true') {
      toggle.dataset.mednerdsCollapse = 'true';
      toggle.addEventListener('click', () => setSidebarCollapsed(!isSidebarCollapsed()));
    }

  }

  function initialiseSidebarAccordion() {
    const topLevelDetails = getTopLevelDetails();
    const sidebarContent = document.querySelector<HTMLElement>('.sidebar-content');
    sidebarContent?.classList.add('mn-sidebar-syncing');

    /*
     * Nur die Hauptgruppe offen lassen,
     * die die aktive Seite enthält.
     *
     * Auf /meddocs/ liegt die aktive Seite außerhalb
     * aller Hauptgruppen → alle bleiben geschlossen.
     */
    const activeLink = document.querySelector(
      '.sidebar-content .top-level > li > details a[aria-current="page"]'
    );

    const activeDetails = activeLink?.closest(
      '.sidebar-content .top-level > li > details'
    );

    for (const details of topLevelDetails) {
      const shouldBeOpen = !isSidebarCollapsed() && details === activeDetails;
      if (details.open !== shouldBeOpen) details.open = shouldBeOpen;
    }
    persistSidebarOpenState();

    if (sidebarContent) {
      void sidebarContent.offsetWidth;
      requestAnimationFrame(() => sidebarContent.classList.remove('mn-sidebar-syncing'));
    }

    /*
     * Accordion nur für die oberste Ebene:
     * Öffnet sich eine Hauptgruppe, schließen alle anderen.
     */
    for (const details of topLevelDetails) {
      if (details.dataset.mednerdsAccordion === 'true') {
        continue;
      }

      details.dataset.mednerdsAccordion = 'true';

      details.addEventListener('toggle', () => {
        if (details.open) {
          closeOtherTopLevelGroups(details);
        }
      });
    }

    /*
     * Globaler MedDocs-Übersichtslink:
     * beim Klick alle Hauptgruppen schließen.
     */
    const topLevelLinks = document.querySelectorAll(
      '.sidebar-content .top-level > li > a'
    );

    for (const link of topLevelLinks) {
      if (!(link instanceof HTMLAnchorElement)) continue;

      if (link.dataset.mednerdsOverview === 'true') {
        continue;
      }

      link.dataset.mednerdsOverview = 'true';

      link.addEventListener('click', () => {
        closeAllTopLevelGroups();
      });
    }
  }

  /*
   * Reveal-Animation für alle <details>-Gruppen.
   *
   * Die Klasse wird bereits beim Klick auf <summary>
   * gesetzt, also bevor das native <details> sichtbar
   * geöffnet wird.
   *
   * Dadurch gibt es beim normalen Aufklappen keinen
   * sichtbaren Zwischenframe.
   */
  function initialiseRevealAnimations() {
    const detailsElements = document.querySelectorAll(
      '.sidebar-content .top-level details'
    );

    for (const details of detailsElements) {
      if (!(details instanceof HTMLDetailsElement)) continue;

      if (details.dataset.mednerdsReveal === 'true') {
        continue;
      }

      details.dataset.mednerdsReveal = 'true';

      const summary = details.querySelector(':scope > summary');

      if (!(summary instanceof HTMLElement)) continue;

      summary.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        /*
         * Normales manuelles Öffnen:
         * Animation bereits vor dem nativen Toggle vorbereiten.
         */
        if (!details.open) {
          details.classList.remove('mn-opening');

          void details.offsetWidth;

          details.classList.add('mn-opening');
        }
      });

      details.addEventListener('toggle', () => {
        /*
         * Beim Schließen sofort aufräumen.
         */
        if (!details.open) {
          details.classList.remove('mn-opening');
          return;
        }

        /*
         * Die Animation läuft 350 ms.
         */
        window.setTimeout(() => {
          details.classList.remove('mn-opening');
        }, 420);
      });
    }
  }

  function initialiseMedNerdsSidebar() {
    initialiseSidebarIcons();
    initialiseSidebarLabels();
    initialiseCollapsedGroupLinks();
    initialiseCollapseControl();
    /*
     * 1. korrekten Accordion-Zustand herstellen
     * 2. normale Reveal-Animationen registrieren
     * 3. Haupttitel über das native <details> auf- und zuklappen
     */
    initialiseSidebarAccordion();
    initialiseRevealAnimations();
  }

  /*
   * Erster Seitenaufbau.
   */
  initialiseMedNerdsSidebar();

  /*
   * Nach clientseitigen Astro-Navigationen erneut
   * initialisieren.
   */
  document.addEventListener(
    'astro:page-load',
    initialiseMedNerdsSidebar
  );

  compactDesktopSidebar.addEventListener('change', () => {
    syncSidebarCollapsedState();
    initialiseSidebarAccordion();
    updateSidebarToggle();
  });
</script>

<style is:global>
  .sidebar-content .top-level > li > a.mn-sidebar-collapsed-link {
    display: none;
  }

  @media (min-width: 50rem) {
    .sidebar-content:has(.mn-sidebar-toggle) {
      padding-bottom: 0.1rem;
    }

    .sidebar-content:has(.mn-sidebar-toggle)::after {
      display: none;
    }

    .sidebar-content .top-level > li {
      position: relative;
    }

    .sidebar-content .top-level > li > details {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 100ms ease,
        visibility 0s linear;
    }

    .sidebar-content .top-level > li > a.mn-sidebar-collapsed-link {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 2rem;
      padding-inline: 0.5rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 110ms ease,
        visibility 0s linear 110ms;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) {
      --mn-sidebar-visual-width:
        var(--mn-left-rail-collapsed-width);
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 90ms ease,
        visibility 0s linear 90ms;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > a.mn-sidebar-collapsed-link {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 70ms, 0s;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > a.mn-sidebar-collapsed-link[aria-current] {
      background: var(--mn-sidebar-active-bg);
      color: var(--sl-color-accent);
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details > ul,
    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level .mn-sidebar-label-text,
    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details > summary .mn-sidebar-badge,
    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details > summary svg.caret {
      display: none;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > a,
    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details > summary {
      justify-content: center;
      padding-inline: 0.5rem;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > a > span:first-child,
    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details > summary > .group-label,
    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .top-level > li > details > summary > .group-label > .large {
      flex: 0 0 auto;
      width: auto;
      min-width: 0;
      margin: 0;
      overflow: visible;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .sidebar-content .mn-sidebar-icon {
      margin-inline-end: 0;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .mn-sidebar-toggle {
      justify-content: center;
      gap: 0;
      width: 100%;
      padding-inline: 0;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .mn-sidebar-toggle-label {
      max-width: 0;
      opacity: 0;
    }

    :root.mn-sidebar-collapsed:has(.mn-sidebar-toggle) .mn-sidebar-toggle .mn-icon {
      transform: rotate(180deg);
    }
  }

  .sidebar-content.mn-sidebar-syncing .top-level summary svg.caret {
    transition: none;
  }

  .mn-sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    align-self: flex-end;
    margin-top: auto;
    padding: 0.5rem 0.625rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
    transition:
      gap 220ms cubic-bezier(0.2, 0, 0, 1),
      background-color 140ms ease,
      color 140ms ease;
  }

  .mn-sidebar-toggle-label {
    display: inline-block;
    max-width: 8rem;
    overflow: hidden;
    opacity: 1;
    white-space: nowrap;
    transition:
      max-width 220ms cubic-bezier(0.2, 0, 0, 1),
      opacity 100ms ease;
  }

  .mn-sidebar-toggle .mn-icon {
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .mn-sidebar-toggle:hover {
    background: var(--mn-sidebar-hover-bg);
    color: var(--sl-color-accent);
  }

  .mn-sidebar-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 49.99rem) {
    .mn-sidebar-toggle {
      display: none;
    }
  }

  /* ========================================
     Sidebar row alignment
     ======================================== */

  /*
   * Ganze oberste Navigationszeile vertikal
   * zentrieren.
   *
   * Besonders wichtig für "Übersicht",
   * weil dort der aktive Hintergrund auf dem
   * gesamten <a>-Element liegt.
   */
  .sidebar-content
    .top-level
    > li
    > a {
    display: flex;
    align-items: center;
  }

  /*
   * Auch die Hauptgruppen:
   *
   * EKG
   * Echokardiographie
   * Sonographie
   * Notfallmedizin
   * Diverses
   *
   * werden als vollständige Zeile vertikal
   * zentriert.
   */
  .sidebar-content
    .top-level
    > li
    > details
    > summary {
    align-items: center;
  }

  /*
   * Icon + Text innerhalb des jeweiligen Labels
   * ebenfalls sauber zentrieren.
   *
   * Dadurch beeinflussen unterschiedliche
   * Font-Metriken das SVG nicht.
   */
  .sidebar-content
    .top-level
    > li
    > a
    > span:first-child,
  .sidebar-content
    .top-level
    > li
    > details
    > summary
    > .group-label
    > .large {
    display: inline-flex;
    align-items: center;

    min-width: 0;
  }

  /*
   * Einheitliches Verhalten der Sidebar-Icons.
   *
   * display:block verhindert die typische
   * zusätzliche Inline-SVG-Baseline.
   *
   * Eine gemeinsame feste Größe hält SVG- und
   * Markenicon in beiden Sidebar-Zuständen identisch.
   */
  .sidebar-content .mn-sidebar-icon {
    display: block;

    flex: 0 0 auto;
    align-self: center;

    width: 1.5rem;
    height: 1.5rem;

    margin-inline-end: 0.5rem;

    pointer-events: none;
  }

  .sidebar-content .mn-sidebar-brand-icon {
    object-fit: contain;
  }

  /* ========================================
     Sidebar Reveal
     ======================================== */

  /*
   * Alle untergeordneten Elemente erscheinen
   * gleichzeitig.
   *
   * 350 ms entspricht dem gewünschten Tempo.
   */
  .sidebar-content
    .top-level
    details.mn-opening
    > ul {
    animation:
      mn-sidebar-reveal
      350ms
      cubic-bezier(0.2, 0, 0, 1)
      both;
  }

  @keyframes mn-sidebar-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========================================
     Reduced Motion
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .sidebar-content .top-level > li > details,
    .sidebar-content .top-level > li > a.mn-sidebar-collapsed-link,
    .mn-sidebar-toggle,
    .mn-sidebar-toggle-label,
    .mn-sidebar-toggle .mn-icon {
      transition: none;
    }

    .sidebar-content
      .top-level
      details.mn-opening
      > ul {
      animation: none;
    }
  }
</style>
