---
import MedNerdsIcon from './MedNerdsIcon.astro';
import MedNerdsBaselMembershipForm from './MedNerdsBaselMembershipForm.astro';

const activities = [
  {
    title: 'Wissen teilen',
    description: 'Freie medizinische Lerninhalte',
    icon: 'tabler:book-2',
  },
  {
    title: 'Gemeinsam üben',
    description: 'Workshops, Skills & Simulationen',
    icon: 'tabler:stethoscope',
  },
  {
    title: 'Austausch',
    description: 'Fälle diskutieren und voneinander lernen',
    icon: 'tabler:messages',
  },
  {
    title: 'Wissen weitergeben',
    description: 'Peer Learning, Tutoring & Mentoring',
    icon: 'tabler:users-group',
  },
] as const;
---

<div class="mn-basel not-content">
  <section class="basel-section basel-section--pillars" aria-labelledby="basel-pillars-title">
    <div class="section-heading">
      <p class="section-label">Digital + persönlich</p>
      <h2 id="basel-pillars-title">Zwei Wege, gemeinsam zu lernen</h2>
    </div>
    <div class="pillar-grid">
      <article class="pillar-card">
        <div class="pillar-top">
          <span class="pillar-icon"><MedNerdsIcon name="tabler:device-desktop" size="lg" /></span>
          <span class="pillar-label">Digital</span>
        </div>
        <h3>MedNerds</h3>
        <p>Medizinisches Wissen frei und strukturiert zugänglich machen.</p>
        <a href="/" class="pillar-cta">
          MedNerds entdecken
          <MedNerdsIcon name="tabler:arrow-right" size="sm" />
        </a>
      </article>
      <article class="pillar-card">
        <div class="pillar-top">
          <span class="pillar-icon"><MedNerdsIcon name="tabler:users-group" size="lg" /></span>
          <span class="pillar-label">Persönlich</span>
        </div>
        <h3>Vor Ort & miteinander</h3>
        <p>Workshops, Fälle, Skills, Simulationen und gemeinsames Lernen.</p>
        <a class="pillar-cta" href="#mitglied-werden">
          Mitglied werden
          <MedNerdsIcon name="tabler:arrow-right" size="sm" />
        </a>
      </article>
    </div>
  </section>
  <section
    id="mitglied-werden"
    class="basel-section basel-section--membership"
    aria-labelledby="basel-membership-title"
  >
    <div class="section-heading">
      <p class="section-label">MedNerds Basel</p>
      <h2 id="basel-membership-title">Mitglied werden</h2>
    </div>
    <div class="membership-intro">
      <p>Du möchtest Teil von MedNerds Basel werden? Sende uns deine Kontaktdaten und wir melden uns bei dir.</p>
      <p class="membership-contact">
        Alternativ erreichst du uns unter <a href="mailto:mednerds@mednerds.ch">mednerds@mednerds.ch</a>.
      </p>
    </div>
    <MedNerdsBaselMembershipForm />
  </section>
  <section id="spenden" class="basel-section" aria-labelledby="basel-donations-title">
    <div class="section-heading">
      <p class="section-label">MedNerds Basel</p>
      <h2 id="basel-donations-title">Spenden</h2>
    </div>
    <p class="section-description">
      Mit deiner Unterstützung hilfst du MedNerds Basel dabei, offene medizinische Bildung,
      Workshops und Projekte weiter auszubauen. Das Spendenformular folgt in einem nächsten Schritt.
    </p>
  </section>
</div>

<style>
  .mn-basel {
    --basel-section-space: clamp(2.5rem, 5vw, 4.5rem);
    display: grid;
    gap: var(--basel-section-space);
    padding-block-start: var(--basel-section-space);
    color: var(--sl-color-gray-2);
  }

  .mn-basel :is(h2, h3, p, ul) {
    margin: 0;
  }

  .mn-basel :is(h2, h3) {
    color: var(--sl-color-white);
  }

  .mn-basel a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .basel-section {
    display: grid;
    gap: 1.1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .basel-section--pillars {
    border-top: 0;
  }

  .basel-section[id] {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  .membership-intro {
    display: grid;
    gap: 0.5rem;
    line-height: 1.6;
  }

  .membership-contact {
    font-size: 0.9rem;
  }

  .membership-contact a {
    color: var(--sl-color-accent);
    text-underline-offset: 0.15em;
  }

  .section-description {
    max-width: 75ch;
    line-height: 1.6;
  }

  .section-heading {
    display: grid;
    gap: 0.2rem;
  }

  .section-heading h2 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.3;
  }

  .section-label,
  .pillar-label {
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    min-width: 0;
    padding: 1.35rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.85rem;
    background: var(--mn-surface);
  }

  .pillar-top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.25rem;
  }

  .pillar-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.7rem;
    color: var(--sl-color-accent);
  }

  .pillar-card h3 {
    font-size: 1.15rem;
  }

  .pillar-card p {
    line-height: 1.5;
  }

  .pillar-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    gap: 0.5rem;
    margin-top: auto;
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.55rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 700;
    text-decoration: none;
  }

  .pillar-cta:hover {
    background: var(--sl-color-accent-high);
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .activity-tile {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
  }

  .activity-tile :global(.mn-icon) {
    color: var(--sl-color-accent);
  }

  .activity-tile h3 {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .activity-tile p {
    font-size: 0.875rem;
    line-height: 1.45;
  }

  @media (max-width: 56rem) {
    .activity-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .pillar-grid,
    .activity-grid {
      grid-template-columns: 1fr;
    }

    .pillar-card {
      padding: 1.1rem;
    }
  }
</style>
