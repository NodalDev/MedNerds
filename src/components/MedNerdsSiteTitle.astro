---
import mainLight from '../assets/Logos/MedNerds - horizontal - hell.webp?url';
import mainDark from '../assets/Logos/MedNerds - horizontal - dunkel.webp?url';
import ProductLogo from './ProductLogo.astro';
import { getActiveProduct } from '../data/product-navigation';

const pathname = Astro.url.pathname;
const activeProduct = getActiveProduct(pathname);
---

<div class="brand-lockup">
  <a href="/" class="main-brand" aria-label="MedNerds Startseite">
    <img class="brand-light" src={mainLight} width="661" height="144" alt="MedNerds" />
    <img class="brand-dark" src={mainDark} width="661" height="144" alt="MedNerds" />
  </a>
  {
    activeProduct && (
      <>
        <span class="brand-divider" aria-hidden="true" />
        <a class="section-brand" href={activeProduct.href} aria-label={`${activeProduct.label} Startseite`}>
          <ProductLogo product={activeProduct.product} />
        </a>
      </>
    )
  }
</div>

<style>
  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    white-space: nowrap;
  }

  .main-brand,
  .section-brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }

  .main-brand img {
    width: auto;
    height: 2.55rem;
  }

  .brand-divider {
    flex: 0 0 auto;
    width: 1px;
    height: 2.1rem;
    background: var(--sl-color-gray-5);
  }

  .section-brand {
    --product-logo-height: 1.95rem;
    max-width: 11rem;
  }

  .section-brand :global(.product-logo) {
    transform: translateY(10%);
  }

  @media (max-width: 49.999rem) {
    .brand-lockup {
      gap: 0.5rem;
    }

    .main-brand img {
      height: 1.7rem;
    }

    .brand-divider {
      height: 1.6rem;
    }

    .section-brand {
      --product-logo-height: 1.25rem;
      max-width: 5.75rem;
    }
  }

  @media (max-width: 28rem) {
    .brand-lockup {
      gap: 0.35rem;
    }

    .main-brand img {
      height: 1.5rem;
    }

    .brand-divider {
      height: 1.3rem;
    }

    .section-brand {
      --product-logo-height: 1.05rem;
      max-width: 4.75rem;
    }
  }
</style>
