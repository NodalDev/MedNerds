---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import MedNerdsSiteFooter from './MedNerdsSiteFooter.astro';

const hasSidebar = Astro.locals.starlightRoute.hasSidebar;
---

<div class="page">
  <!-- ========================================
       Globaler Header
       ======================================== -->

  <header class="header">
    <slot name="header" />
  </header>

  <!-- ========================================
       Dokumentationsbereich
       ======================================== -->

  <div
    class:list={{
      'page-body': true,
      'page-body--with-sidebar': hasSidebar,
    }}
  >
    {
      hasSidebar && (
        <nav
          class="sidebar print:hidden"
          aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}
        >
          <MobileMenuToggle />

          <div
            id="starlight__sidebar"
            class="sidebar-pane"
          >
            <div class="sidebar-content sl-flex">
              <slot name="sidebar" />
            </div>
          </div>
        </nav>
      )
    }

    <div class="main-frame">
      <slot />
    </div>
  </div>
</div>

<!-- ========================================
     Globaler Website-Footer
     ======================================== -->

<MedNerdsSiteFooter />

<style>
  @layer starlight.core {
    /* ========================================
       Gesamte Seite
       ======================================== */

    .page {
      min-height: 100vh;
    }

    /*
     * Dieser Bereich ist gleichzeitig die Grenze
     * für die sticky Sidebar.
     *
     * Mindestens Viewporthöhe, damit sie bei kurzen
     * Seiten nicht vorzeitig endet.
     */
    .page-body {
      min-width: 0;
      min-height: 100vh;
    }

    /* ========================================
       Header
       ======================================== */

    .header {
      position: fixed;
      z-index: var(--sl-z-index-navbar);

      inset-block-start: 0;
      inset-inline-start: 0;

      width: 100%;
      height: var(--sl-nav-height);

      padding:
        var(--sl-nav-pad-y)
        var(--sl-nav-pad-x);

      padding-inline-end: var(--sl-nav-pad-x);

      border-bottom:
        1px solid var(--sl-color-hairline-shade);

      background-color: var(--sl-color-bg-nav);
    }

    /*
     * Auf Mobile Platz für den Menübutton lassen.
     */
    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) +
        var(--sl-nav-pad-x) +
        var(--sl-menu-button-size)
      );
    }

    /* ========================================
       Sidebar – Mobile
       ======================================== */

    /*
     * Mobile bleibt wie bei Starlight:
     * Sidebar als Drawer über dem Inhalt.
     */
    .sidebar-pane {
      visibility: var(
        --sl-sidebar-visibility,
        hidden
      );

      position: fixed;
      z-index: var(--sl-z-index-menu);

      inset-block:
        var(--sl-nav-height)
        0;

      inset-inline-start: 0;

      width: 100%;

      overflow-y: auto;

      background-color: var(--sl-color-black);

      scrollbar-gutter: stable;
    }

    :global([aria-expanded='true'])
      ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      min-height: max-content;
      height: 100%;

      padding:
        1rem
        var(--sl-sidebar-pad-x)
        0;

      flex-direction: column;
      gap: 1rem;
    }

    /* ========================================
       Hauptinhalt – Mobile
       ======================================== */

    .main-frame {
      min-width: 0;

      padding-top: calc(
        var(--sl-nav-height) +
        var(--sl-mobile-toc-height)
      );
    }

    /* ========================================
       Desktop
       ======================================== */

    @media (min-width: 50rem) {
      /*
       * Mobilen Menü-Abstand wieder entfernen.
       */
      :global([data-has-sidebar]) .header {
        padding-inline-end:
          var(--sl-nav-pad-x);
      }

      /* ----------------------------------------
         Grid
         ---------------------------------------- */

      .page-body--with-sidebar {
        display: grid;

        grid-template-columns:
          var(--sl-sidebar-width)
          minmax(0, 1fr);

        align-items: stretch;

        min-width: 0;
      }

      /* ----------------------------------------
         Sticky Sidebar-Container
         ---------------------------------------- */

      /*
       * WICHTIG:
       *
       * Jetzt ist der äußere NAV-Container sticky,
       * nicht mehr die scrollbare sidebar-pane.
       */
      .sidebar {
        position: sticky;

        top: var(--sl-nav-height);

        align-self: start;

        min-width: 0;

        height: calc(
          100vh - var(--sl-nav-height)
        );
      }

      /* ----------------------------------------
         Sidebar-Innenfläche
         ---------------------------------------- */

      /*
       * Die eigentliche Pane ist jetzt ganz normal
       * innerhalb des sticky Containers.
       */
      .sidebar-pane {
        --sl-sidebar-visibility: visible;

        position: static;

        visibility: visible;

        width: 100%;
        height: 100%;

        overflow-y: auto;
        overscroll-behavior: contain;

        background-color:
          var(--sl-color-bg-sidebar);

        border-inline-end:
          1px solid
          var(--sl-color-hairline-shade);

        scrollbar-gutter: auto;
      }

      .sidebar-content::after {
        content: '';

        padding-bottom: 1px;
      }

      /* ----------------------------------------
         Hauptinhalt
         ---------------------------------------- */

      .main-frame {
        min-width: 0;

        /*
         * Der Header ist fixed, daher beginnt
         * der Content darunter.
         */
        padding-top:
          var(--sl-nav-height);

        /*
         * Kein zusätzlicher Sidebar-Offset:
         * Die Sidebar besitzt jetzt bereits
         * ihre eigene Grid-Spalte.
         */
        padding-inline-start: 0;
      }
    }
  }
</style>