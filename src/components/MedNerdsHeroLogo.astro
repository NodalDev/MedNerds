---
import logoUrl from '../assets/Logos/MedNerds - icon.webp?url';
---

<mednerds-hero-logo
  class="relative isolate mx-auto block aspect-square w-56 max-w-full sm:w-64 lg:w-80"
  aria-hidden="true"
>
  <div class="glow pointer-events-none absolute inset-0"></div>
  <div class="logo-plane relative h-full w-full">
    <img
      src={logoUrl}
      alt=""
      width="513"
      height="512"
      loading="eager"
      decoding="async"
      draggable="false"
      class="pointer-events-none block h-full w-full select-none"
    />
  </div>
</mednerds-hero-logo>

<style>
  mednerds-hero-logo {
    perspective: 900px;
  }

  .logo-plane {
    transform-style: preserve-3d;
    transform: translate3d(var(--shift-x, 0px), var(--shift-y, 0px), var(--depth, 0px))
      rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .glow {
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-MedNerds-400) 28%, transparent) 0%,
      color-mix(in srgb, var(--color-MedNerds-500) 35%, transparent) 40%,
      transparent 70%
    );
    filter: blur(24px);
    transform: translate(var(--glow-x, 0px), var(--glow-y, 0px));
    transition: transform 650ms cubic-bezier(0.25, 1, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    [data-tilting] .logo-plane {
      transition-duration: 160ms;
      will-change: transform;
    }

    [data-tilting] .glow {
      transition-duration: 250ms;
    }
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .logo-plane,
    .glow {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  class MedNerdsHeroLogo extends HTMLElement {
    private cleanup?: AbortController;
    private frame = 0;

    connectedCallback() {
      this.cleanup?.abort();
      this.cleanup = new AbortController();
      const { signal } = this.cleanup;
      const motion = matchMedia(
        '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)'
      );
      const properties = [
        '--tilt-x', '--tilt-y', '--shift-x', '--shift-y', '--depth', '--glow-x', '--glow-y',
      ];
      const reset = () => {
        cancelAnimationFrame(this.frame);
        this.removeAttribute('data-tilting');
        properties.forEach((name) => this.style.removeProperty(name));
      };

      this.addEventListener('pointermove', (event: PointerEvent) => {
        if (!motion.matches || event.pointerType !== 'mouse') return;
        // Measure the stationary wrapper so the tilt cannot feed back into its own coordinates.
        const rect = this.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const clamp = (value: number) => Math.max(-1, Math.min(1, value));
        const x = clamp(((event.clientX - rect.left) / rect.width) * 2 - 1);
        const y = clamp(((event.clientY - rect.top) / rect.height) * 2 - 1);
        cancelAnimationFrame(this.frame);
        this.frame = requestAnimationFrame(() => {
          this.setAttribute('data-tilting', '');
          this.style.setProperty('--tilt-x', `${-y * 8}deg`);
          this.style.setProperty('--tilt-y', `${x * 8}deg`);
          this.style.setProperty('--shift-x', `${x * 2}px`);
          this.style.setProperty('--shift-y', `${y * 2}px`);
          this.style.setProperty('--depth', '4px');
          this.style.setProperty('--glow-x', `${x * 6}px`);
          this.style.setProperty('--glow-y', `${y * 6}px`);
        });
      }, { signal });
      this.addEventListener('pointerleave', reset, { signal });
      this.addEventListener('pointercancel', reset, { signal });
      motion.addEventListener('change', reset, { signal });
    }

    disconnectedCallback() {
      this.cleanup?.abort();
      cancelAnimationFrame(this.frame);
    }
  }

  if (!customElements.get('mednerds-hero-logo')) {
    customElements.define('mednerds-hero-logo', MedNerdsHeroLogo);
  }
</script>
