---
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const tagline = data.hero?.tagline;
const action = data.hero?.actions?.[0];

const topics = [
  'EKG',
  'Echo',
  'Sonographie',
  'Notfallmedizin',
  'Intensivmedizin',
  'Anästhesiologie',
  'Kardiologie',
] as const;
---

<header class="basel-hero not-content">
  <div class="basel-hero-copy">
    <h1 id="_top" data-page-title>{data.title}</h1>
    {tagline && <p>{tagline}</p>}
    {action && (
      <div class="basel-hero-action">
        <LinkButton href={action.link} variant={action.variant} icon={action.icon?.name}>
          {action.text}
        </LinkButton>
      </div>
    )}
  </div>

  <section class="basel-topics" aria-labelledby="basel-topics-title">
    <h2 id="basel-topics-title" class="sr-only">Was uns interessiert</h2>
    <ul class="topic-cloud">
      {topics.map((topic) => <li class="topic-node"><span>{topic}</span></li>)}
    </ul>
  </section>
</header>

<style>
  .basel-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1rem;
  }

  .basel-hero-copy {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    min-width: 0;
  }

  .basel-hero-copy h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.75rem, 4.5vw, 4.5rem);
    font-weight: 650;
    line-height: 1.1;
  }

  .basel-hero-copy p {
    max-width: 38ch;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.6;
  }

  .basel-hero-action {
    justify-self: start;
  }

  .basel-topics {
    min-width: 0;
    align-self: end;
  }

  .topic-cloud {
    position: relative;
    width: 100%;
    height: 17rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-node {
    position: absolute;
    color: color-mix(in srgb, var(--sl-color-accent) 75%, var(--sl-color-gray-1));
    opacity: var(--topic-opacity, 0.9);
    font-size: var(--topic-size, 1.05rem);
    font-weight: var(--topic-weight, 600);
    line-height: 1.3;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    animation: topic-drift var(--topic-duration, 10s) ease-in-out infinite alternate;
    animation-delay: var(--topic-delay, 0s);
  }

  .topic-node::before {
    position: absolute;
    inset: -1rem;
    content: '';
  }

  .topic-node span {
    display: inline-block;
    cursor: default;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 420ms cubic-bezier(0.2, 1.3, 0.35, 1);
  }

  .topic-node:nth-child(1) {
    left: 9%;
    top: 53%;
    --topic-size: 0.95rem;
    --topic-opacity: 0.84;
    --topic-duration: 11s;
    --topic-delay: -3s;
    --drift-x: 5px;
    --drift-y: -6px;
    --hover-x: -14px;
    --hover-y: 8px;
  }

  .topic-node:nth-child(2) {
    left: 77%;
    top: 15%;
    --topic-size: 0.95rem;
    --topic-opacity: 0.84;
    --topic-duration: 12s;
    --topic-delay: -5s;
    --drift-x: -5px;
    --drift-y: 6px;
    --hover-x: 12px;
    --hover-y: -10px;
  }

  .topic-node:nth-child(3) {
    left: 46%;
    top: 26%;
    --topic-size: 1.2rem;
    --topic-opacity: 0.98;
    --topic-weight: 650;
    --topic-duration: 10s;
    --drift-x: -7px;
    --drift-y: 5px;
    --hover-x: 16px;
    --hover-y: 6px;
  }

  .topic-node:nth-child(4) {
    left: 76%;
    top: 58%;
    --topic-size: 1.24rem;
    --topic-opacity: 1;
    --topic-weight: 650;
    --topic-duration: 12s;
    --topic-delay: -4s;
    --drift-x: 6px;
    --drift-y: -8px;
    --hover-x: -12px;
    --hover-y: -14px;
  }

  .topic-node:nth-child(5) {
    left: 48%;
    top: 83%;
    --topic-size: 1.07rem;
    --topic-duration: 9s;
    --topic-delay: -6s;
    --drift-x: -5px;
    --drift-y: -7px;
    --hover-x: 10px;
    --hover-y: 12px;
  }

  .topic-node:nth-child(6) {
    left: 17%;
    top: 15%;
    --topic-size: 1.07rem;
    --topic-duration: 13s;
    --topic-delay: -2s;
    --drift-x: 7px;
    --drift-y: 5px;
    --hover-x: -9px;
    --hover-y: -13px;
  }

  .topic-node:nth-child(7) {
    left: 16%;
    top: 85%;
    --topic-size: 1.2rem;
    --topic-opacity: 0.98;
    --topic-weight: 650;
    --topic-duration: 11s;
    --topic-delay: -7s;
    --drift-x: 5px;
    --drift-y: -9px;
    --hover-x: -16px;
    --hover-y: 5px;
  }

  @keyframes topic-drift {
    to {
      transform: translate(
        calc(-50% + var(--drift-x)),
        calc(-50% + var(--drift-y))
      );
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .topic-node:hover span {
      transform: translate(var(--hover-x), var(--hover-y));
    }
  }

  @media (max-width: 62rem) {
    .basel-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      padding-block: 2.5rem 1rem;
    }

    .basel-topics {
      width: min(100%, 44rem);
      margin-inline-start: auto;
    }

    .topic-cloud {
      height: 11rem;
    }
  }

  @media (max-width: 40rem) {
    .basel-hero {
      gap: 1.75rem;
      padding-block: 1.5rem 0.5rem;
    }

    .basel-hero-copy {
      justify-items: center;
      gap: 1rem;
      text-align: center;
    }

    .basel-hero-copy h1 {
      font-size: clamp(2.25rem, 8vw, 2.75rem);
    }

    .basel-hero-action {
      justify-self: center;
    }

    .basel-topics {
      width: 100%;
    }

    .topic-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem 1.5rem;
      height: auto;
    }

    .topic-node {
      position: static;
      animation: none;
      transform: none;
    }

    .topic-node::before {
      display: none;
    }

    .topic-node span {
      transition: none;
    }

    .topic-node:hover span {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-node {
      animation: none;
    }

    .topic-node span {
      transition: none;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .topic-node:hover span {
      transform: none;
    }
  }
</style>
