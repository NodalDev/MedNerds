---
import { citationStyles, defaultCitationStyle } from '../../lib/meddocs/references/format';
import { allCitationSources, type CitationPayload } from '../../lib/meddocs/references/model';
import { Icon } from 'astro-icon/components';
type Props = CitationPayload;
const payload = Astro.props;
const sources = allCitationSources(payload);
---
<dialog class="citation-dialog" id="meddocs-citation-dialog" aria-labelledby="citation-title" data-citation-payload={JSON.stringify(payload)}>
  <header class="citation-dialog-header"><h2 id="citation-title">Zitieren &amp; Exportieren</h2></header>
  <div class="citation-field">
    <label for="citation-target">Was möchtest du zitieren?</label>
    <select id="citation-target" data-citation-target>
      <option value="article">Diesen MedDocs-Artikel zitieren</option>
      {payload.cited.length > 0 && <option value="cited">Einzelnachweise exportieren</option>}
      {payload.literature.length > 0 && <option value="literature">Literatur &amp; weiterführende Quellen exportieren</option>}
      {sources.length > 0 && <option value="references">Alle Quellen exportieren</option>}
      {sources.length > 0 && <optgroup label="Einzelne Quelle exportieren">{sources.map((item) => <option value={`reference:${item.id}`}>{item.title}</option>)}</optgroup>}
    </select>
  </div>
  <div class="citation-field">
    <label for="citation-style">Zitierstil</label>
    <select id="citation-style" data-citation-style>
      <optgroup label="Wissenschaftliche Zitierstile">{citationStyles.filter((style) => style.id !== defaultCitationStyle).map((style) => <option value={style.id} selected={style.id === 'vancouver'}>{style.label}</option>)}</optgroup>
      <optgroup label="MedNerds Zitierstil">{citationStyles.filter((style) => style.id === defaultCitationStyle).map((style) => <option value={style.id}>{style.label}</option>)}</optgroup>
    </select>
  </div>
  <div class="citation-preview-region">
    <p class="citation-preview-label" id="citation-preview-label">Zitatvorschau</p>
    <div class="citation-preview" data-citation-preview role="region" aria-labelledby="citation-preview-label" tabindex="0"></div>
    <p data-citation-status role="status" aria-live="polite" aria-atomic="true"></p>
    <button type="button" data-citation-retry hidden>Erneut versuchen</button>
  </div>
  <div class="citation-actions">
    <button type="button" class="citation-copy" data-citation-copy><Icon name="tabler:copy" size={18} is:inline aria-hidden="true" focusable="false" />In die Zwischenablage kopieren</button>
    <div class="citation-exports">
      <button type="button" data-citation-export="txt" aria-label="Als TXT exportieren"><Icon name="tabler:download" size={16} is:inline aria-hidden="true" focusable="false" />TXT</button>
      <button type="button" data-citation-export="bib" aria-label="Als BibTeX exportieren"><Icon name="tabler:download" size={16} is:inline aria-hidden="true" focusable="false" />BibTeX</button>
      <button type="button" data-citation-export="ris" aria-label="Als RIS exportieren"><Icon name="tabler:download" size={16} is:inline aria-hidden="true" focusable="false" />RIS</button>
    </div>
  </div>
  <footer class="citation-dialog-footer">
    <div class="citation-licenses">
      <p class="citation-attribution"><a href="https://github.com/Juris-M/citeproc-js" rel="noopener noreferrer">citeproc-js</a> · © 2009–2019 Frank Bennett · <a href="/licenses/citeproc-CPAL-1.0.txt">CPAL 1.0</a></p>
    </div>
    <button type="button" data-citation-close aria-label="Zitierdialog schliessen">Schliessen</button>
  </footer>
</dialog>
<script>
  import { initializeCitationDialog } from '../../lib/meddocs/references/dialog';
  initializeCitationDialog();
  document.addEventListener('astro:page-load', initializeCitationDialog);
</script>
