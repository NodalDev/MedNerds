<script>
  const form = document.querySelector<HTMLFormElement>('#mn-basel-membership-form');

  if (form) {
    // Associate vendor-inserted error text with its field without changing submission logic.
    const updateErrorDescriptions = () => {
      for (const field of form.querySelectorAll<HTMLElement>('.inf-input')) {
        const input = field.querySelector<HTMLInputElement>('input[data-inf-meta]');
        if (!input) continue;
        const message = field.querySelector<HTMLElement>('.inf-message');
        const errorId = `${input.id}-error`;
        const descriptions = (input.getAttribute('aria-describedby') ?? '')
          .split(' ').filter((id) => id && id !== errorId);

        if (message) {
          message.id = errorId;
          input.setAttribute('aria-invalid', 'true');
          descriptions.push(errorId);
        } else {
          input.removeAttribute('aria-invalid');
        }

        if (descriptions.length) input.setAttribute('aria-describedby', descriptions.join(' '));
        else input.removeAttribute('aria-describedby');
      }
    };

    updateErrorDescriptions();
    new MutationObserver(updateErrorDescriptions).observe(form, { childList: true, subtree: true });
  }
</script>

