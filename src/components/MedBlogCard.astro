---
import { Image } from 'astro:assets';
import { medBlogAreas, medBlogTypes, medBlogPostHref } from '../data/medblog';
import { authors } from '../data/authors';
import { articleDateTime, formatArticleDate } from '../lib/meddocs/article-metadata';
import type { MedBlogPost } from '../lib/medblog/posts';

interface Props {
  post: MedBlogPost;
  variant?: 'featured' | 'editorial' | 'compact' | 'standard';
}

const { post, variant = 'standard' } = Astro.props;
const { data } = post;
const href = medBlogPostHref(data.type, post.id);
---

<article
  class:list={['blog-card', `blog-card--${variant}`, `blog-card--${data.type}`]}
  data-blog-post
  data-type={data.type}
  data-areas={data.areas.join(' ')}
  data-tags={JSON.stringify(data.tags)}
>
  {data.image && (
    <div class="card-image" data-fit={data.image.fit}>
      <Image src={data.image.src} alt={data.image.alt} widths={[360, 720, 1080]} sizes="(min-width: 72rem) 540px, (min-width: 50rem) 50vw, 100vw" loading="lazy" />
    </div>
  )}
  <div class="card-copy">
    <p class="card-classification">
      <span>{medBlogTypes[data.type].label}</span>
      <span aria-hidden="true">·</span>
      <span>{data.areas.map((area) => medBlogAreas[area].label).join(' / ')}</span>
      {data.draft && <span class="draft-label">Entwurf</span>}
    </p>
    <h3><a class="title-link" href={href}>{data.title}</a></h3>
    <p class="card-description">{data.description}</p>
    <p class="card-meta">
      <span>{data.authors.map((id) => authors[id].name).join(', ')}</span>
      <span aria-hidden="true">·</span>
      <time datetime={articleDateTime(data.published)}>{formatArticleDate(data.published)}</time>
    </p>
    {data.tags.length > 0 && (
      <ul class="card-tags" role="list" aria-label="Themen">
        {data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
    <div class="card-links">
      <span class="read-more" aria-hidden="true">Beitrag lesen <span>→</span></span>
      {data.cta && <a class="card-cta" href={data.cta.href}>{data.cta.label} <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--mn-surface);
    transition: border-color 160ms ease, background-color 160ms ease;
    overflow-wrap: anywhere;
  }

  .blog-card[hidden] { display: none; }
  .card-image { overflow: hidden; border-radius: 0.7rem 0.7rem 0 0; }
  .card-image :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .card-image[data-fit='contain'] :global(img) { object-fit: contain; padding: 1.5rem; }
  .card-copy { display: flex; flex-direction: column; gap: 0.875rem; flex: 1; min-width: 0; padding: 1.5rem; }
  p, h3, ul { margin: 0; }
  .card-classification { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; color: var(--sl-color-accent); font-size: var(--sl-text-xs); font-weight: 600; }
  .draft-label { color: var(--sl-color-gray-3); }
  h3 { font-size: 1.25rem; font-weight: 600; line-height: 1.35; text-wrap: pretty; }
  .title-link { color: var(--sl-color-white); text-decoration: none; }
  .title-link::after { content: ''; position: absolute; inset: 0; border-radius: 0.75rem; }
  .title-link:focus-visible { outline: none; }
  .title-link:focus-visible::after { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  .card-description { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); line-height: 1.65; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); line-height: 1.5; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.375rem 0.75rem; padding: 0; list-style: none; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .card-tags li::before { content: '#'; }
  .card-links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; margin-top: auto; padding-top: 0.5rem; font-size: var(--sl-text-xs); font-weight: 600; color: var(--sl-color-accent); }
  .read-more { display: inline-flex; gap: 0.5rem; }
  .card-cta { position: relative; z-index: 1; color: inherit; text-underline-offset: 0.2em; }
  .card-cta:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  .blog-card--compact .card-copy { padding: 1.25rem 1.5rem; gap: 0.5rem; }
  .blog-card--compact h3 { font-size: 1.0625rem; }
  .blog-card--featured h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .blog-card--article .card-description { line-height: 1.75; }

  /* Used only by the public archive; existing type-overview variants stay unchanged. */
  .blog-card--editorial { border-top: 3px solid var(--sl-color-accent); }
  .blog-card--editorial h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.25; }
  .blog-card--editorial .card-copy { padding: clamp(1.25rem, 2vw, 2rem); gap: 1rem; }
  .blog-card--editorial .card-image { background: var(--sl-color-accent-low); }
  .blog-card--editorial .card-image :global(img) { max-height: 18rem; }
  .blog-card--editorial .card-image[data-fit='contain'] :global(img) { padding: 2rem; }
  .blog-card--editorial .read-more { font-size: var(--sl-text-sm); }
  @container medblog-feed (min-width: 36rem) {
    .blog-card--editorial:has(.card-image) { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    .blog-card--editorial .card-image { border-radius: 0.7rem 0 0 0.7rem; }
    .blog-card--editorial .card-image :global(img) { height: 100%; max-height: none; }
  }

  @media (min-width: 50rem) {
    .blog-card--featured:has(.card-image) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .blog-card--featured .card-image { border-radius: 0.7rem 0 0 0.7rem; }
    .blog-card--featured .card-image :global(img) { height: 100%; }
  }
  @media (hover: hover) { .blog-card:hover { border-color: var(--sl-color-accent); background: var(--mn-surface-hover); } }
  @media (prefers-reduced-motion: reduce) { .blog-card { transition: none; } }
</style>
