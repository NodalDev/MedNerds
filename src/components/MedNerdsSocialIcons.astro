---
import MedNerdsIcon from './MedNerdsIcon.astro';

const socialLinks = [
  { label: 'YouTube', icon: 'simple-icons:youtube', href: 'https://www.youtube.com/@mednerds' },
  { label: 'Instagram', icon: 'simple-icons:instagram', href: 'https://www.instagram.com/mednerds/' },
  { label: 'GitHub', icon: 'simple-icons:github', href: 'https://github.com/NodalDev/MedNerds' },
  { label: 'LinkedIn', icon: 'simple-icons:linkedin', href: 'https://linkedin.com/company/MedNerds' },
  { label: 'X', icon: 'simple-icons:x', href: 'https://x.com/mednerds' },
] as const;
---

<nav class="mn-header-socials" aria-label="MedNerds auf Social Media">
  {
    socialLinks.map(({ label, icon, href }) => (
      <a href={href} aria-label={label} title={label}>
        <MedNerdsIcon name={icon} size="sm" />
      </a>
    ))
  }
</nav>

<style>
  .mn-header-socials {
    display: none;
    align-items: center;
    gap: 0.1rem;
  }

  .mn-header-socials a {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }

  .mn-header-socials a:hover {
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
  }

  .mn-header-socials a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (min-width: 64rem) {
    .mn-header-socials {
      display: flex;
    }
  }
</style>
